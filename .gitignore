# Local secrets - never commit
.env

# Runtime storage + generated sample PDFs (regenerated by the seeder on startup)
data/storage/
data/samples/*.pdf
data/samples/ground-truth.json

# Node
node_modules/
dist/
# Sandbox-only project-local npm cache (cross-user default cache is not writable here)
.npm-cache/

# Java/Maven
target/
*.class
*.jar
# Sandbox-only project-local Maven repo (pre-seeded cache copy; users run plain mvn)
.m2repo/

# Logs
*.log
docs/test-logs/*.tmp
docs/test-logs/server.err
docs/test-logs/client-e2e.err

# Native-run scratch (pid file, transient tokens/probes; see scripts/start-server)
.run/
# Second native storage dir (multi-instance runs; compose uses data/storage)
data/storage-live/
# Local Playwright browser binaries (TC-E2E-02 runs; users install to the default cache)
.pw-browsers/
# Playwright run outputs (the committed TC-E2E-02 assets live in docs/screenshots + docs/demo-assets)
client/test-results/
client/playwright-report/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
